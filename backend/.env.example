# Copy to .env. Never commit .env or the secrets/ folder.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# OAuth JSON downloaded for a Desktop app in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_FILE=secrets/credentials.json
# Generated by: python manage.py authorize_google_calendar
GOOGLE_OAUTH_TOKEN_FILE=secrets/token.json
# Use primary for the Google account that authorizes OAuth, or the exact calendar ID.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata

# Local VS Code Live Server origins. Add your real frontend origin if different.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501

# Optional: PostgreSQL is a later step. Leave unset for the local SQLite prototype.
# DATABASE_URL=postgresql://appointment_user:URL_ENCODED_PASSWORD@localhost:5432/appointmenthub
